      "type": "object",
      "properties": {
        "linux": {
          "type": "object",
          "properties": {
            "boot_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 4096,
                  "pattern": "^[^\\u0000]*$"
