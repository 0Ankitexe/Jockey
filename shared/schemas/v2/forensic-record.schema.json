                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              ]
            },
            "clock_ticks_per_second": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 4096,
                  "pattern": "^[^\\u0000]*$"
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              ]
            },
            "device_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 4096,
                  "pattern": "^[^\\u0000]*$"
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              ]
            },
            "inode": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 4096,
                  "pattern": "^[^\\u0000]*$"
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              ]
            },
            "socket_inode": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 4096,
                  "pattern": "^[^\\u0000]*$"
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              ]
            },
            "namespace_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 4096,
                  "pattern": "^[^\\u0000]*$"
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              ]
            },
            "unit_path": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 4096,
                  "pattern": "^[^\\u0000]*$"
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              ]
            },
            "journal_cursor": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 4096,
                  "pattern": "^[^\\u0000]*$"
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              ]
            },
            "journal_boot_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 4096,
                  "pattern": "^[^\\u0000]*$"
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              ]
            },
            "mount_type": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 4096,
                  "pattern": "^[^\\u0000]*$"
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              ]
            }
          },
          "required": [],
          "additionalProperties": false,
          "maxProperties": 16
        }
      },
      "required": [
        "linux"
      ],
      "additionalProperties": false
