                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              ]
            },
            "start_ticks": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 4096,
                  "pattern": "^[^\\u0000]*$"
