{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jocky.dev/schemas/v2/forensic-record.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "record_id": {
      "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
    },
    "context": {
      "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/LocalContext"
    },
    "collected_at": {
      "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/TimeObservation"
    },
    "collector": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Collector"
        },
        "version": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Semver"
        },
        "adapter": {
          "type": "string",
          "enum": [
            "linux.kernel-profile-v1",
            "linux.proc-processes-v1",
            "linux.proc-net-v1",
            "linux.systemd-v1",
            "linux.startup-v1",
            "linux.scoped-file-v1",
            "linux.journal-v1",
            "linux.rfc5424-v1",
            "linux.modules-v1",
            "pure.exact-indicators-v1"
          ]
        }
      },
      "required": [
        "name",
        "version",
        "adapter"
      ],
      "additionalProperties": false
    },
    "category": {
      "type": "string",
      "enum": [
        "system",
        "process",
        "network",
        "file",
        "event",
        "persistence",
        "driver",
        "indicator"
      ]
    },
    "severity": {
      "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Severity"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "profile",
        "process",
        "service",
        "connection",
        "entry",
        "metadata",
        "log",
        "module",
        "match"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_id": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
        },
        "source_kind": {
          "type": "string",
          "enum": [
            "kernel_profile",
            "proc_processes",
            "proc_net",
            "sys_modules",
            "systemd_bus",
            "journal_file",
            "text_log",
            "startup_directory",
            "scoped_file",
            "supplied_indicator_set"
          ]
        },
        "observed_start": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/TimeObservation"
        },
        "observed_end": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/TimeObservation"
        },
        "policy_sha256": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Digest"
        },
        "authorisation_sha256": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Digest"
        },
        "request_sha256": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Digest"
        },
        "source_scope": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/SourceScope"
        },
        "indicator_set_sha256": {
          "anyOf": [
            {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "rules_version": {
          "anyOf": [
            {
              "const": "exact-v1"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_id",
        "source_kind",
        "observed_start",
        "observed_end",
        "policy_sha256",
        "authorisation_sha256",
        "request_sha256",
        "source_scope",
        "indicator_set_sha256",
        "rules_version"
      ],
      "additionalProperties": false
    },
    "payload": {},
