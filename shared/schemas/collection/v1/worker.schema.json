        "schema_version": {
          "const": "1.0.0"
        },
        "frame_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "collection_id": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
        },
        "kind": {
          "const": "ready"
        },
        "payload": {
          "type": "object",
          "properties": {
            "job": {
              "type": "string",
              "enum": [
                "collect",
                "publish"
              ]
            }
          },
          "required": [
