          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "frame_seq",
        "collection_id",
        "kind",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "frame_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "collection_id": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
        },
        "kind": {
