          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
        },
        "kind": {
          "const": "cancel"
        },
        "payload": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "Cancelled",
                "AuthorisationExpired",
                "Timeout",
                "ResourceLimit",
                "ClockUncertain"
              ]
            }
          },
          "required": [
            "code"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "frame_seq",
        "collection_id",
        "kind",
        "payload"
      ],
      "additionalProperties": false
