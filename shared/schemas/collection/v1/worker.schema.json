    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "frame_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "collection_id": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
        },
        "kind": {
          "const": "done"
        },
        "payload": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "job": {
                  "const": "collect"
                },
                "outcome": {
                  "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Outcome"
                },
                "usage": {
                  "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/WorkUsed"
                }
              },
              "required": [
                "job",
                "outcome",
                "usage"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "job": {
                  "const": "publish"
                },
                "code": {
                  "type": "string",
                  "enum": [
                    "PublishedComplete",
                    "PublicationFailed",
                    "OutputExists",
                    "CleanupIncomplete"
                  ]
                },
                "sha256": {
                  "anyOf": [
                    {
                      "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Digest"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "byte_length": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10485760
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "created_identity": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "device_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 20,
                          "pattern": "^[^\\u0000]*$"
                        },
                        "inode": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 20,
                          "pattern": "^[^\\u0000]*$"
                        }
                      },
                      "required": [
                        "device_id",
                        "inode"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "job",
                "code",
                "sha256",
                "byte_length",
                "created_identity"
              ],
              "additionalProperties": false
