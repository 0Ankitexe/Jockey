{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jocky.dev/schemas/collection/v1/worker.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "frame_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "collection_id": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
        },
        "kind": {
          "const": "start"
        },
        "payload": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "job": {
                  "const": "collect"
                },
                "collector": {
                  "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Collector"
                },
                "inputs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "type": "string",
                        "enum": [
                          "designation",
                          "authorisation",
                          "policy",
                          "request",
                          "indicators"
                        ]
                      },
                      "byte_length": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 524288
                      },
                      "sha256": {
                        "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Digest"
                      }
                    },
                    "required": [
                      "role",
                      "byte_length",
                      "sha256"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 4,
                  "maxItems": 5,
                  "uniqueItems": true
                },
                "input_byte_length": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 786432
                },
                "input_sha256": {
                  "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Digest"
                }
              },
              "required": [
                "job",
                "collector",
                "inputs",
                "input_byte_length",
                "input_sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "job": {
                  "const": "publish"
                },
                "context": {
                  "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/LocalContext"
                },
                "output_descriptor": {
                  "type": "integer",
                  "minimum": 3,
                  "maximum": 1048576
                },
                "output_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255,
                  "pattern": "^(?!\\.{1,2}$)[^/\\u0000]+$"
                },
                "report_byte_length": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10485760
                },
                "report_sha256": {
                  "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Digest"
                }
              },
              "required": [
                "job",
                "context",
                "output_descriptor",
                "output_name",
                "report_byte_length",
                "report_sha256"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "frame_seq",
        "collection_id",
        "kind",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "frame_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "collection_id": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
        },
        "kind": {
          "const": "start_chunk"
        },
        "payload": {
          "type": "object",
          "properties": {
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 83886080
            },
            "data": {
              "type": "string",
              "maxLength": 87384,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          },
          "required": [
            "offset",
            "data"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "frame_seq",
        "collection_id",
        "kind",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
