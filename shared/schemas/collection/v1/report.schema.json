{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jocky.dev/schemas/collection/v1/report.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "report_kind": {
      "type": "string",
      "enum": [
        "live_lab",
        "synthetic_test"
      ]
    },
    "context": {
      "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/LocalContext"
    },
    "started_at": {
      "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/TimeObservation"
    },
    "finished_at": {
      "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/TimeObservation"
    },
    "endpoint": {
      "anyOf": [
        {
          "$ref": "https://jocky.dev/schemas/collection/v1/endpoint-observation.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputs": {
      "type": "object",
      "properties": {
        "designation": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
            },
            "schema_version": {
              "const": "1.0.0"
            },
            "sha256": {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Digest"
            }
          },
          "required": [
            "id",
            "schema_version",
            "sha256"
          ],
          "additionalProperties": false
        },
        "authorisation": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
            },
            "schema_version": {
              "const": "1.0.0"
            },
            "sha256": {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Digest"
            }
          },
          "required": [
            "id",
            "schema_version",
            "sha256"
          ],
          "additionalProperties": false
        },
        "policy": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
            },
            "schema_version": {
              "const": "1.0.0"
            },
            "sha256": {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Digest"
            }
          },
          "required": [
            "id",
            "schema_version",
            "sha256"
          ],
          "additionalProperties": false
        },
        "request": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
            },
            "schema_version": {
              "const": "1.0.0"
            },
            "sha256": {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Digest"
            }
          },
          "required": [
            "id",
            "schema_version",
            "sha256"
          ],
          "additionalProperties": false
        },
        "indicators": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
                },
                "schema_version": {
                  "const": "1.0.0"
                },
                "sha256": {
                  "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Digest"
                }
              },
              "required": [
                "id",
                "schema_version",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "designation",
        "authorisation",
        "policy",
        "request",
        "indicators"
      ],
      "additionalProperties": false
    },
    "collectors": {
      "type": "array",
      "items": {
        "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Outcome"
      },
      "minItems": 1,
      "maxItems": 9
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "https://jocky.dev/schemas/v2/forensic-record.schema.json"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/ItemError"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "summary": {
      "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Summary"
    },
    "manifest": {
      "$ref": "https://jocky.dev/schemas/v2/evidence-manifest.schema.json"
    },
    "content_sha256": {
      "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Digest"
    }
  },
  "required": [
    "schema_version",
    "report_kind",
    "context",
    "started_at",
    "finished_at",
    "endpoint",
    "inputs",
    "collectors",
    "records",
    "errors",
    "summary",
    "manifest",
    "content_sha256"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "endpoint": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "summary": {
            "properties": {
              "stop_reason": {
                "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Code"
              }
            }
          }
        }
      }
    }
  ]
}
