{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jocky.dev/schemas/collection/v1/types.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schema_version"
  ],
  "additionalProperties": false,
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "Utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000)[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Semver": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "Label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]*$"
    },
    "Text": {
      "type": "string",
      "minLength": 0,
      "maxLength": 65536,
      "pattern": "^[^\\u0000]*$"
    },
    "Count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Code": {
      "type": "string",
      "enum": [
        "InvalidInput",
        "UnsupportedVersion",
        "MissingAuthorisation",
        "AuthorisationDenied",
        "AuthorisationExpired",
        "ScopeDenied",
        "PermissionDenied",
        "Unsupported",
        "NotImplemented",
        "NotFound",
        "FacilityUnavailable",
        "UnsupportedFormat",
        "UnsupportedEncoding",
        "UnknownTimezone",
        "MalformedSource",
        "SourceChanged",
        "SourceDisappeared",
        "AmbiguousOwner",
        "ResourceLimit",
        "Timeout",
        "Cancelled",
        "ClockUncertain",
        "WorkerProtocol",
        "WorkerFailed",
        "PublicationFailed",
        "OutputExists",
        "AliasDenied",
        "CleanupIncomplete",
        "NotRequested"
      ]
    },
    "Capability": {
      "type": "string",
      "enum": [
        "system",
        "processes",
        "network",
        "files",
        "events",
        "persistence",
        "drivers",
        "indicators"
      ]
    },
    "Collector": {
      "type": "string",
      "enum": [
        "system",
        "processes",
        "services",
        "connections",
        "persistence",
        "files",
        "events",
        "drivers",
        "indicators"
      ]
    },
    "SourceKind": {
      "type": "string",
      "enum": [
        "kernel_profile",
        "proc_processes",
        "proc_net",
        "sys_modules",
        "systemd_bus",
        "journal_file",
        "text_log",
        "startup_directory"
      ]
    },
    "OsFamily": {
      "type": "string",
      "enum": [
        "linux",
        "windows"
      ]
    },
    "Severity": {
      "type": "string",
      "enum": [
        "informational",
        "low",
        "medium",
        "high",
        "critical",
        "unknown"
      ]
    },
    "CollectorStatus": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "unsupported",
        "unavailable",
        "permission_denied",
        "failed"
      ]
    },
    "RelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!\\.{1,2}(/|$))[^/\\u0000]+(?:/(?!\\.{1,2}(/|$))[^/\\u0000]+){0,15}$"
    },
    "AbsolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/(?!\\.{1,2}(/|$))[^/\\u0000]+(?:/(?!\\.{1,2}(/|$))[^/\\u0000]+)*$",
      "not": {
        "enum": [
          "/proc",
          "/sys",
          "/dev"
        ]
      }
    },
    "PathRef": {
      "type": "object",
      "properties": {
        "root_id": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
        },
        "relative_path": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/RelativePath"
        }
      },
      "required": [
        "root_id",
        "relative_path"
      ],
      "additionalProperties": false
    },
    "RootGrant": {
      "type": "object",
      "properties": {
        "root_id": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
        },
        "absolute_path": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/AbsolutePath"
        },
        "purposes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "files",
              "logs",
              "persistence",
              "journal"
            ]
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        }
      },
      "required": [
        "root_id",
        "absolute_path",
        "purposes"
      ],
      "additionalProperties": false
    },
    "UtcWindow": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Utc"
        },
        "end": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Utc"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "Limits": {
      "type": "object",
      "properties": {
        "max_records": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_report_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "max_source_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "max_item_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "max_errors": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_entries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "max_indicator_comparisons": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 10000,
          "maximum": 60000
        },
        "operation_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "max_staging_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 83886080
        },
        "max_memory_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        }
      },
      "required": [
        "max_records",
        "max_report_bytes",
        "max_source_bytes",
        "max_file_bytes",
        "max_item_bytes",
        "max_errors",
        "max_entries",
        "max_depth",
        "max_indicator_comparisons",
        "timeout_ms",
        "operation_timeout_ms",
        "max_staging_bytes",
        "max_memory_bytes"
      ],
      "additionalProperties": false
    },
    "Scope": {
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Capability"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "source_groups": {
          "type": "array",
          "items": {
            "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/SourceKind"
          },
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true
        },
        "roots": {
          "type": "array",
          "items": {
            "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/RootGrant"
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        },
        "event_window": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/UtcWindow"
        }
      },
      "required": [
        "capabilities",
        "source_groups",
        "roots",
        "event_window"
      ],
      "additionalProperties": false
    },
    "LocalContext": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "local_lab"
        },
        "collection_id": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
        },
        "case_id": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
        },
        "operator_id": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
        },
        "endpoint_id": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
        },
        "designation_id": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
        },
        "authorisation_id": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
        },
        "policy_id": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
        }
      },
      "required": [
        "mode",
        "collection_id",
        "case_id",
        "operator_id",
        "endpoint_id",
        "designation_id",
        "authorisation_id",
        "policy_id"
      ],
      "additionalProperties": false
    },
    "TimeObservation": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Utc"
        },
        "basis": {
          "const": "local_clock"
        },
        "uncertainty_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "clock_uncertain": {
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "basis",
        "uncertainty_ms",
        "clock_uncertain"
      ],
      "additionalProperties": false
    },
    "FieldText": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "available"
            },
            "value": {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Text"
            }
          },
          "required": [
            "state",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "unavailable"
            },
            "reason": {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Code"
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "FieldCount": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "available"
            },
            "value": {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Count"
            }
          },
          "required": [
            "state",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "unavailable"
            },
            "reason": {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Code"
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "FieldUtc": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "available"
            },
            "value": {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Utc"
            }
          },
          "required": [
            "state",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "unavailable"
            },
            "reason": {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Code"
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "FieldDigest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "available"
            },
            "value": {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Digest"
            }
          },
          "required": [
            "state",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "unavailable"
            },
            "reason": {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Code"
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "FieldUuid": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "available"
            },
            "value": {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
            }
          },
          "required": [
            "state",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "unavailable"
            },
            "reason": {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Code"
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ProcessIdentity": {
      "type": "object",
      "properties": {
        "boot_id": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "start_ticks": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      },
      "required": [
        "boot_id",
        "pid",
        "start_ticks"
      ],
      "additionalProperties": false
    },
    "Coverage": {
      "type": "object",
      "properties": {
        "source_id": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
        },
        "state": {
          "type": "string",
          "enum": [
            "supported",
            "unsupported",
            "permission_denied",
            "unavailable",
            "partial"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Code"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_id",
        "state",
        "reason"
      ],
      "additionalProperties": false
    },
    "WorkUsed": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000
        },
        "indicator_comparisons": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "errors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1001
        },
        "source_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "staging_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 83886080
        },
        "retained_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 268435456
        }
      },
      "required": [
        "entries",
        "indicator_comparisons",
        "errors",
        "source_bytes",
        "staging_bytes",
        "retained_bytes"
      ],
      "additionalProperties": false
    },
    "SourceScope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "facility"
            },
            "source_id": {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
            },
            "namespace": {
              "const": "current"
            }
          },
          "required": [
            "kind",
            "source_id",
            "namespace"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "path"
            },
            "path": {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/PathRef"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "indicators"
            },
            "indicator_set_id": {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
            }
          },
          "required": [
            "kind",
            "indicator_set_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "FieldPath": {
      "type": "string",
      "enum": [
        "/payload/kernel_release",
        "/payload/kernel_version",
        "/payload/architecture",
        "/payload/hostname",
        "/payload/distribution_id",
        "/payload/distribution_version",
        "/payload/boot_id",
        "/payload/parent_pid",
        "/payload/uid",
        "/payload/command",
        "/payload/executable",
        "/payload/start_identity",
        "/payload/description",
        "/payload/load_state",
        "/payload/active_state",
        "/payload/sub_state",
        "/payload/unit_file_state",
        "/payload/owners",
        "/payload/namespace",
        "/payload/enabled_state",
        "/payload/referenced_targets",
        "/payload/content_sha256",
        "/payload/size_bytes",
        "/payload/mode",
        "/payload/gid",
        "/payload/mtime",
        "/payload/ctime",
        "/payload/sha256",
        "/payload/location",
        "/payload/local_address",
        "/payload/remote_address",
        "/payload/event_time",
        "/payload/domain",
        "/payload/version",
        "/payload/source_version"
      ]
    },
    "ItemError": {
      "type": "object",
      "properties": {
        "error_id": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
        },
        "collector": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Collector"
        },
        "source_id": {
          "anyOf": [
            {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "item_ref": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "field_path": {
          "anyOf": [
            {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/FieldPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Code"
        },
        "retryable": {
          "const": false
        },
        "counted_omission": {
          "type": "boolean"
        }
      },
      "required": [
        "error_id",
        "collector",
        "source_id",
        "item_ref",
        "field_path",
        "code",
        "retryable",
        "counted_omission"
      ],
      "additionalProperties": false
    },
    "Outcome": {
      "type": "object",
      "properties": {
        "collector": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Collector"
        },
        "status": {
          "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/CollectorStatus"
        },
        "coverage": {
          "type": "array",
          "items": {
            "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Coverage"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "accepted_records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "omitted_records": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "omitted_reason": {
          "anyOf": [
            {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Code"
            },
            {
              "type": "null"
            }
          ]
        },
        "errors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1001
        },
        "stop_reason": {
          "anyOf": [
            {
              "$ref": "https://jocky.dev/schemas/collection/v1/types.schema.json#/$defs/Code"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "collector",
        "status",
        "coverage",
        "accepted_records",
        "omitted_records",
        "omitted_reason",
        "errors",
        "stop_reason"
      ],
      "additionalProperties": false
    },
